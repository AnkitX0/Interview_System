# Frontend Environment Variables Template
# Copy to .env.local and adjust values for your local setup.
# .env.local is gitignored — never commit it.
#
# Backend URL. Default assumes the FastAPI server is on port 8000.
# If port 8000 is occupied by another process on your machine, start
# the backend on a different port and set VITE_API_URL accordingly:
#   uvicorn backend.main:app --reload --port 8001
#   VITE_API_URL=http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8000

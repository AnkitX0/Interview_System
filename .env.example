# ==============================================================================
# Environment Configuration - AI Interview Intelligence Preparation System
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# NEVER commit production secrets or real API keys to version control.

# Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Database Configuration (SQLite by default; supports PostgreSQL for production)
DATABASE_URL=sqlite:///./interview.db

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8001
HOST=0.0.0.0

# ==============================================================================
# Environment Configuration - Interview Intelligence Preparation System
# ==============================================================================
# Copy this template to `.env` for local configuration.
# NEVER commit real production credentials, API keys, or App Passwords to git.

# ------------------------------------------------------------------------------
# 1. Environment & URLs
# ------------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Development: SQLite (local file)
DATABASE_URL=sqlite:///./interview.db
# Production: PostgreSQL example:
# DATABASE_URL=postgresql://postgres_user:postgres_password@db.provider.com:5432/interview_intelligence

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-characters
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 4. Email Delivery Infrastructure
# ------------------------------------------------------------------------------
# Provider choice: 'development' | 'smtp' | 'resend'
# - 'development': captures emails in-memory and in data/dev_emails.log (safe local dev/test)
# - 'smtp': dispatches real emails via SMTP (Mailpit, Google App Password, SendGrid, Amazon SES)
# - 'resend': dispatches transactional emails via Resend HTTP API
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@interviewintelligence.com

# SMTP Settings (Required if EMAIL_PROVIDER=smtp)
# For local Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, no credentials
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your@gmail.com, SMTP_PASSWORD=16_char_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Resend API Key (Required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 5. Google Gemini AI API Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Never expose this key in frontend code or VITE_* variables.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ------------------------------------------------------------------------------
# 6. Object / File Storage Configuration
# ------------------------------------------------------------------------------
# Provider choice: 'local' | 's3'
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# S3 / Cloudflare R2 Settings (Required if STORAGE_PROVIDER=s3)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 7. Network, CORS & Server Settings
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8001
HOST=0.0.0.0
